module Pixel10:
    generic_pixel = new ATOPILE_PIXEL10

module Pixel15:
    generic_pixel = new ATOPILE_PIXEL15

module BridgableRGBWUI:
    anodes = new RGBWWUI
    cathodes = new RGBWWUI

    trait can_bridge_by_name<input_name = "anodes", output_name = "cathodes">

module RGBWUI_HL5050 from BridgableRGBWUI:

    rgbw = new HONGLITRONIC_HL_5050RGBW_S1_A27_model
    rgbw.red.cathode ~ cathodes.red
    rgbw.green.cathode ~ cathodes.green
    rgbw.blue.cathode ~ cathodes.blue
    rgbw.cold_white.cathode ~ cathodes.cold_white

    rgbw.red.anode ~ anodes.red
    rgbw.green.anode ~ anodes.green
    rgbw.blue.anode ~ anodes.blue
    rgbw.cold_white.anode ~ anodes.cold_white

module RGBWUI_TC5050 from BridgableRGBWUI:

    rgbw = new TCWIN_TC5050RGBW4D06_4CJHR3_AFW421A_model
    rgbw.red.cathode ~ cathodes.red
    rgbw.green.cathode ~ cathodes.green
    rgbw.blue.cathode ~ cathodes.blue
    rgbw.cold_white.cathode ~ cathodes.cold_white

    rgbw.red.anode ~ anodes.red
    rgbw.green.anode ~ anodes.green
    rgbw.blue.anode ~ anodes.blue
    rgbw.cold_white.anode ~ anodes.cold_white


module Pixel10HL5050 from Pixel10:
    rgb = new RGBWUI_HL5050
    rgb.anodes ~ generic_pixel.anodes
    # Compiler bug hack
    rgb.anodes.red ~ generic_pixel.anodes.red
    rgb.anodes.green ~ generic_pixel.anodes.green
    rgb.anodes.blue ~ generic_pixel.anodes.blue
    rgb.anodes.cold_white ~ generic_pixel.anodes.cold_white
    # End compiler bug hack
    rgb.cathodes ~ generic_pixel.pixel_if.cathodes

module Pixel10TC5050 from Pixel10:
    rgb = new RGBWUI_TC5050
    # rgb.anodes ~ generic_pixel.anodes
    rgb.anodes.red ~ generic_pixel.anodes.red
    rgb.anodes.green ~ generic_pixel.anodes.green
    rgb.anodes.blue ~ generic_pixel.anodes.blue
    rgb.anodes.cold_white ~ generic_pixel.anodes.cold_white

    rgb.cathodes ~ generic_pixel.pixel_if.cathodes

module Pixel15HL5050 from Pixel15:
    rgbs = new RGBWUI_HL5050[4]
    generic_pixel.anodes ~> rgbs[0] ~> rgbs[1] ~> rgbs[2] ~> rgbs[3] ~> generic_pixel.pixel_if.cathodes

    # Compiler bug hack
    generic_pixel.anodes.red ~ rgbs[0].anodes.red
    generic_pixel.anodes.green ~ rgbs[0].anodes.green
    generic_pixel.anodes.blue ~ rgbs[0].anodes.blue
    generic_pixel.anodes.cold_white ~ rgbs[0].anodes.cold_white


module Pixel15TC5050 from Pixel15:
    rgbs = new RGBWUI_TC5050[4]
    generic_pixel.anodes ~> rgbs[0] ~> rgbs[1] ~> rgbs[2] ~> rgbs[3] ~> generic_pixel.pixel_if.cathodes

    # Compiler bug hack
    generic_pixel.anodes.red ~ rgbs[0].anodes.red
    generic_pixel.anodes.green ~ rgbs[0].anodes.green
    generic_pixel.anodes.blue ~ rgbs[0].anodes.blue
    generic_pixel.anodes.cold_white ~ rgbs[0].anodes.cold_white
    # End compiler bug hack

module Row2:
    pixels = new Pixel15HL5050[2]

module Cluster2x2:
    power_leds = new ElectricPower
    # power_leds.required = True
    power_leds.voltage = 5V to 17V

    power_driver = new ElectricPower
    # power_driver.required = True

    # trait has_single_electric_reference_shared<gnd_only=True>

    rows = new Row2[2]
    driver = new Macroblock_MBI5043

    decoupling_capacitors = new Capacitor[8]
    for cap in decoupling_capacitors:
        cap.capacitance = 10uF +/- 20%
        cap.max_voltage = 25V
        cap.package = "C0805"
        cap.power ~ power_leds

    power_driver ~ driver.power

    power_leds.hv ~ rows[0].pixels[0].generic_pixel.pixel_if.anode 
    rows[0].pixels[0].generic_pixel.pixel_if.cathodes.red ~ driver.led_outputs[3].line
    rows[0].pixels[0].generic_pixel.pixel_if.cathodes.green ~ driver.led_outputs[2].line
    rows[0].pixels[0].generic_pixel.pixel_if.cathodes.blue ~ driver.led_outputs[1].line
    rows[0].pixels[0].generic_pixel.pixel_if.cathodes.cold_white ~ driver.led_outputs[0].line

    rows[0].pixels[1].generic_pixel.pixel_if.anode ~ power_leds.hv
    rows[0].pixels[1].generic_pixel.pixel_if.cathodes.red ~ driver.led_outputs[7].line
    rows[0].pixels[1].generic_pixel.pixel_if.cathodes.green ~ driver.led_outputs[6].line
    rows[0].pixels[1].generic_pixel.pixel_if.cathodes.blue ~ driver.led_outputs[5].line
    rows[0].pixels[1].generic_pixel.pixel_if.cathodes.cold_white ~ driver.led_outputs[4].line

    rows[1].pixels[0].generic_pixel.pixel_if.anode ~ power_leds.hv
    rows[1].pixels[0].generic_pixel.pixel_if.cathodes.red ~ driver.led_outputs[15].line
    rows[1].pixels[0].generic_pixel.pixel_if.cathodes.green ~ driver.led_outputs[14].line
    rows[1].pixels[0].generic_pixel.pixel_if.cathodes.blue ~ driver.led_outputs[13].line
    rows[1].pixels[0].generic_pixel.pixel_if.cathodes.cold_white ~ driver.led_outputs[12].line

    rows[1].pixels[1].generic_pixel.pixel_if.anode ~ power_leds.hv
    rows[1].pixels[1].generic_pixel.pixel_if.cathodes.red ~ driver.led_outputs[8].line
    rows[1].pixels[1].generic_pixel.pixel_if.cathodes.green ~ driver.led_outputs[9].line
    rows[1].pixels[1].generic_pixel.pixel_if.cathodes.blue ~ driver.led_outputs[10].line
    rows[1].pixels[1].generic_pixel.pixel_if.cathodes.cold_white ~ driver.led_outputs[11].line


    data_in = new ElectricLogic
    data_out = new ElectricLogic
    data_clock = new ElectricLogic
    global_clock = new ElectricLogic
    latch = new ElectricLogic

    data_in ~ driver.sdi
    data_out ~ driver.sdo
    data_clock ~ driver.dclk
    global_clock ~ driver.gclk
    latch ~ driver.le

    trait can_bridge_by_name<input_name = "data_in", output_name = "data_out">

    for cap in decoupling_capacitors:
        trait cap has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C15850">
    trait driver.bypass_capacitor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait driver.rext_resistor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C3016011">

module ClusterRow:
    power_leds = new ElectricPower
    power_leds.voltage = 5V to 17V
    power_driver = new ElectricPower
    
    # External interfaces for connection to microcontroller/next pannel
    data_in = new ElectricLogic
    data_in_micro = new ElectricLogic
    data_out = new ElectricLogic
    data_clock = new ElectricLogic
    global_clock = new ElectricLogic
    latch = new ElectricLogic
    
    # Internal 5V interfaces for connection to clusters
    data_in_5v = new ElectricLogic
    data_out_5v = new ElectricLogic
    data_clock_5v = new ElectricLogic
    global_clock_5v = new ElectricLogic
    latch_5v = new ElectricLogic

    # Level shifters between 3V3 (microcontroller) and 5V (MBI5043)
    sdi_shifter = new Diodes_Inc_74LVC1T45DW_7
    sdi_micro_shifter = new Diodes_Inc_74LVC1T45DW_7
    dclk_shifter = new Diodes_Inc_74LVC1T45DW_7
    gclk_shifter = new Diodes_Inc_74LVC1T45DW_7
    latch_shifter = new Diodes_Inc_74LVC1T45DW_7

    # Translator power rails and direction control
    for sh in [sdi_shifter, dclk_shifter, gclk_shifter, latch_shifter]:
        sh.power_a ~ data_in.reference
        sh.power_b ~ power_driver
        sh.dir.line ~ data_in.reference.vcc   # A -> B (3V3 → 5V)

    # Bridged signal connections through translators
    data_in ~> sdi_shifter ~> data_in_5v
    data_clock ~> dclk_shifter ~> data_clock_5v
    global_clock ~> gclk_shifter ~> global_clock_5v
    latch ~> latch_shifter ~> latch_5v
    
    # Direct connection for data_out (no level shifting)
    data_out ~ data_out_5v

    clusters = new Cluster2x2[14]

    for cluster in clusters:
        power_leds ~ cluster.power_leds
        power_driver ~ cluster.power_driver
        data_clock_5v ~ cluster.data_clock
        global_clock_5v ~ cluster.global_clock
        latch_5v ~ cluster.latch

    trait can_bridge_by_name<input_name = "data_in", output_name = "data_out">

    data_in_5v ~> clusters[0] ~> clusters[1] ~> clusters[2] ~> clusters[3] ~> clusters[4] ~> clusters[5] ~> clusters[6].data_in
    clusters[6].data_out ~> clusters[7] ~> clusters[8] ~> clusters[9] ~> clusters[10] ~> clusters[11] ~> clusters[12] ~> clusters[13] ~> data_out_5v


module Panel:
    micro = new ST_STM32H723
    usb_c = new USB2_0TypeCVerticalConnector
    ldo = new LDK220M_R
    led_power_connector = new XT30_Female_Right_Angle
    clusters = new ClusterRow[14]
    debug_header = new SaleaeHeaderRightAngle_2
    led_power = new ElectricPower
    led_power.required = True
    led_power.voltage = 5V to 17V
    power_5v = new ElectricPower
    data_clock = new ElectricLogic
    global_clock = new ElectricLogic
    latch = new ElectricLogic
    power_3v3 = new ElectricPower

    # Micro connections
    usb_c.usb ~ micro.usb

    # GPIO connections for cluster control
    gpios = new ElectricLogic[5]
    gpios[0] ~ micro.gpio_a[0]  # SDI (data in)
    gpios[1] ~ micro.gpio_a[1]  # DCLK (data clock)
    gpios[2] ~ micro.gpio_a[2]  # GCLK (global clock)
    gpios[3] ~ micro.gpio_a[3]  # LATCH
    gpios[4] ~ micro.gpio_a[4]  # SDO (data out)

    # 3V3 signal distribution to all clusters
    data_in = new ElectricLogic
    data_out = new ElectricLogic
    data_clock = new ElectricLogic
    global_clock = new ElectricLogic
    latch = new ElectricLogic

    # Connect GPIOs to 3V3 signals
    gpios[0] ~ data_in
    gpios[1] ~ data_clock
    gpios[2] ~ global_clock
    gpios[3] ~ latch
    gpios[4] ~ data_out

    # Power rail indicator LEDs
    led_3v3 = new LEDIndicatorGreen
    led_5v  = new LEDIndicatorBlue

    power_3v3.vcc ~> led_3v3 ~> power_3v3.gnd
    power_5v.vcc   ~> led_5v   ~> power_5v.gnd


    # Configure regulator
    ldo.output_voltage = 3.3V +/- 3%
    # ldo.feedback_divider.r_top.resistance = 17.8kohm +/- 1%
    ldo.feedback_divider.r_bottom.resistance = 10kohm +/- 1%

    # Power connections
    led_power_connector.power ~ led_power
    usb_c.usb.usb_if.buspower ~ power_5v
    power_5v ~> ldo ~>  power_3v3
    power_3v3 ~ micro.power_3v3

    # Connect clusters to power and control signals
    for cluster in clusters:
        cluster.power_leds ~ led_power
        cluster.power_driver ~ power_5v
        cluster.power_3v3 ~ power_3v3
        cluster.data_clock ~ data_clock
        cluster.global_clock ~ global_clock
        cluster.latch ~ latch

    # Chain data signals through clusters
    data_in ~> clusters[0].data_in
    clusters[0].data_out ~> clusters[1].data_in
    clusters[1].data_out ~> clusters[2].data_in
    clusters[2].data_out ~> clusters[3].data_in
    clusters[3].data_out ~> clusters[4].data_in
    clusters[4].data_out ~> clusters[5].data_in
    clusters[5].data_out ~> clusters[6].data_in
    clusters[6].data_out ~> clusters[7].data_in
    clusters[7].data_out ~> clusters[8].data_in
    clusters[8].data_out ~> clusters[9].data_in
    clusters[9].data_out ~> clusters[10].data_in
    clusters[10].data_out ~> clusters[11].data_in
    clusters[11].data_out ~> clusters[12].data_in
    clusters[12].data_out ~> clusters[13].data_in
    clusters[13].data_out ~ data_out

    # Debug header connections (3V3 signals)
    debug_header.headers[0].channels[0] ~ data_in
    debug_header.headers[0].channels[1] ~ data_out
    debug_header.headers[0].channels[2] ~ data_clock
    debug_header.headers[0].channels[3] ~ global_clock
    debug_header.headers[0].channels[0].reference.gnd ~ power_3v3.gnd
    debug_header.headers[1].channels[0] ~ latch
    debug_header.headers[1].channels[1].line ~ power_5v.vcc
    debug_header.headers[1].channels[2].line ~ power_3v3.vcc
    debug_header.headers[1].channels[0].reference.gnd ~ power_3v3.gnd

    data_clock.line.override_net_name = "data_clock"
    global_clock.line.override_net_name = "global_clock"
    latch.line.override_net_name = "latch"

    power_5v.vcc.override_net_name = "power_5v"
    led_power.vcc.override_net_name = "power_leds"

    # Ground connections
    led_power.gnd ~ power_5v.gnd
    led_power.gnd ~ power_3v3.gnd

    trait has_single_electric_reference_shared<gnd_only=True>

    # Explicit picks
    trait debug_header.headers[0].protection_resistors[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait debug_header.headers[0].protection_resistors[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait debug_header.headers[0].protection_resistors[2] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait debug_header.headers[0].protection_resistors[3] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait debug_header.headers[1].protection_resistors[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait debug_header.headers[1].protection_resistors[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait debug_header.headers[1].protection_resistors[2] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait debug_header.headers[1].protection_resistors[3] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait ldo.feedback_divider.r_bottom has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25744">
    trait ldo.feedback_divider.r_top has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C138044">
    trait ldo.input_decoupling_capacitor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C52923">
    trait ldo.output_decoupling_capacitor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C52923">
    trait led_3v3.resistor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25744">
    trait led_5v.resistor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25744">
    trait micro.decoupling_3v3[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[2] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[3] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[4] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[5] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[6] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[7] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[8] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[9] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_vdda[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_vdda[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.vcap_caps[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C12530">
    trait micro.vcap_caps[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C12530">
    trait micro.vref_caps[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C52923">
    trait micro.vref_caps[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.hse_load_caps[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1548">
    trait micro.hse_load_caps[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1548">
    trait reset_pullup has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25744">
    trait usb_c.cc_resistors[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25905">
    trait usb_c.cc_resistors[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25905">
    trait usb_c.esd_protection.decoupling_capacitor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
