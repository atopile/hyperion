module Panel:
    micro = new ST_STM32H723
    usb_c = new USB2_0TypeCVerticalConnector
    buck = new TPSM863257
    ldo = new TI_TLV75901
    power_in_connector = new XT30_Female_Vertical
    clusters = new DualRow[7]
    data_snake_enable_shifter = new Diodes_Inc_74LVC1T45DW_7
    data_snake_enable_pullup = new Resistor
    jtag_header = new JTAG_10PIN
    debug_headers = new SaleaeHeaderVertical[6]
    switch = new Realtek_RTL8305NB
    phy = new Microchip_LAN8742A
    rj45s = new RJ45_Horizontal_SMD_Magnetics[4]
    thermistors = new ThermistorSensor[9]

    # Interfaces
    led_power = new ElectricPower
    led_power.required = True
    led_power.voltage = 5V to 17V
    power_5v = new ElectricPower
    power_3v3 = new ElectricPower
    data_micro_enable = new ElectricLogic
    data_snake_enable = new ElectricLogic
    data_snake_enable_5v = new ElectricLogic

    # 3V3 signal distribution to all clusters
    data_in = new ElectricLogic
    data_out = new ElectricLogic
    data_clock = new ElectricLogic
    global_clock = new ElectricLogic
    latch = new ElectricLogic

    # Power rail indicator LEDs
    led_3v3 = new LEDIndicatorGreen
    led_5v  = new LEDIndicatorBlue

    # Power distribution
    power_in_connector.power ~ led_power
    led_power ~> buck ~> power_5v
    power_5v ~> ldo ~> power_3v3
    power_3v3 ~ micro.power_3v3

    # Translate the shared active-low snake-data enable into the 5V logic
    # domain before distributing it to the NC7SZ125 output-enable inputs.
    data_snake_enable_shifter.power_a ~ power_3v3
    data_snake_enable_shifter.power_b ~ power_5v
    data_snake_enable_shifter.dir.line ~ power_3v3.vcc
    data_snake_enable ~> data_snake_enable_shifter ~> data_snake_enable_5v
    data_snake_enable_pullup.resistance = 10kohm +/- 5%
    data_snake_enable_pullup.package = "0402"
    power_5v.vcc ~> data_snake_enable_pullup ~> data_snake_enable_5v.line

    # Indicator wiring
    power_3v3.vcc ~> led_3v3 ~> power_3v3.gnd
    power_5v.vcc ~> led_5v ~> power_5v.gnd

    # Configure regulator
    ldo.output_voltage = 3.3V +/- 3%

    # Switch connections
    switch.power_3v3 ~ power_3v3
    switch.ethernets[0] ~ rj45s[0].ethernet
    switch.ethernets[1] ~ rj45s[1].ethernet
    switch.ethernets[2] ~ rj45s[2].ethernet
    switch.ethernets[3] ~ rj45s[3].ethernet
    switch.ethernets[4] ~ phy.ethernet

    # PHY connections - packages are a bit fucked. Need to fix this.
    phy.power_3v3 ~ power_3v3
    mdio = new MDIO
    i2c_mdio = new I2C
    mdio.mdc ~ i2c_mdio.scl
    mdio.mdio ~ i2c_mdio.sda

    mdio ~ phy.mdio
    switch.i2c_mdio ~ i2c_mdio
    # Thermistor connections
    for thermistor in thermistors:
        thermistor.power ~ power_3v3

    # ========== MICROCONTROLLER PINOUT ==========
    # LED data/clock from MCU (HSPI on PF pins via OctoSPI)
    data_clock ~ micro.gpio_f[10]               # PF10 - OCTOSPIM_P1_CLK

    # Cluster shared control signals (use spare OctoSPI data lines)
    clusters[0].data_in_micro ~ micro.gpio_f[8]      # PF8 - OCTOSPIM_P1_IO0
    clusters[1].data_in_micro ~ micro.gpio_f[9]      # PF9 - OCTOSPIM_P1_IO1
    clusters[2].data_in_micro ~ micro.gpio_f[7]      # PF7 - OCTOSPIM_P1_IO2
    clusters[3].data_in_micro ~ micro.gpio_f[6]      # PF6 - OCTOSPIM_P1_IO3
    clusters[4].data_in_micro ~ micro.gpio_e[7]      # PE7 - OCTOSPIM_P1_IO4
    clusters[5].data_in_micro ~ micro.gpio_e[8]      # PE8 - OCTOSPIM_P1_IO5
    clusters[6].data_in_micro ~ micro.gpio_e[9]      # PE9 - OCTOSPIM_P1_IO6

    latch.line ~ micro.gpio_e[10]                   # PE10 - OCTOSPIM_P1_IO7
    global_clock.line ~ micro.gpio_f[2]             # PF2 - OCTOSPIM_P2_IO2

    data_micro_enable ~ micro.gpio_g[2]              # PG2 - TIM24_ETR / TIM8_BKIN
    data_snake_enable ~ micro.gpio_g[3]              # PG3 - TIM23_ETR / TIM8_BKIN2

    # Network Control
    switch.reset ~ micro.gpio_a[5]                   # PA5 - Ethernet switch reset
    phy._reset ~ micro.gpio_a[4]                     # PA4 - ETH reset (LAN8742A nRST)
    mdio.mdc ~ micro.gpio_a[6]                       # PA6 - MDIOS_MDC (MDIO clock)
    mdio.mdio ~ micro.gpio_a[2]                      # PA2 - ETH_MDIO (MDIO data)

    # JTAG/SWD programming header connections
    jtag_header.jtag ~ micro.jtag
    jtag_header.jtag.vtref ~ power_3v3
    
    # Temperature Sensors (ADC)
    thermistors[0].output ~ micro.gpio_c[0]          # PC0  - ADC1_INP10
    thermistors[1].output ~ micro.gpio_c[1]          # PC1  - ADC1_INP11
    thermistors[2].output ~ micro.gpio_c[2]          # PC2_C - ADC1_INP12
    thermistors[3].output ~ micro.gpio_c[3]          # PC3_C - ADC1_INP13
    thermistors[4].output ~ micro.gpio_f[11]         # PF11  - ADC1_INP2
    thermistors[5].output ~ micro.gpio_a[0]          # PA0  - ADC1_INP16
    thermistors[6].output ~ micro.gpio_b[0]          # PB0  - ADC1_INP9
    thermistors[7].output ~ micro.gpio_b[1]          # PB1  - ADC1_INP5
    thermistors[8].output ~ micro.gpio_f[12]         # PF12 - ADC1_INP6

    # USB Interface
    usb_c.usb ~ micro.usb                            # USB 2.0 FS interface
    usb_c.usb.usb_if.buspower.lv ~ power_3v3.gnd
    
    # Ethernet RMII Interface
    phy.rmii ~ micro.rmii                            # RMII MAC interface
    

    # Connect clusters to power and control signals
    for cluster in clusters:
        cluster.power_leds ~ led_power
        cluster.power_driver ~ power_5v
        cluster.data_clock ~ data_clock
        cluster.global_clock ~ global_clock
        cluster.latch ~ latch

    # Chain data signals through clusters
    data_in ~> clusters[0].data_in
    clusters[0].data_out ~> clusters[1].data_in
    clusters[1].data_out ~> clusters[2].data_in
    clusters[2].data_out ~> clusters[3].data_in
    clusters[3].data_out ~> clusters[4].data_in
    clusters[4].data_out ~> clusters[5].data_in
    clusters[5].data_out ~> clusters[6].data_in
    clusters[6].data_out ~ data_out

    # Data mode selection
    for cluster in clusters[1:7]:
        cluster.data_micro_enable ~ data_micro_enable
        cluster.data_snake_enable ~ data_snake_enable_5v

    # First cluster is always from microcontroller
    cluster_0_resistors = new Resistor[2]
    for resistor in cluster_0_resistors:
        resistor.resistance = 0kohm
        resistor.package = "0402"

    clusters[0].data_micro_enable.line ~> cluster_0_resistors[0] ~> power_3v3.vcc
    # /OE is active low. Hold it at 5V to keep the snake input disabled on
    # the first cluster, whose data source is always the microcontroller.
    clusters[0].data_snake_enable.line ~> cluster_0_resistors[1] ~> power_5v.vcc

    # Debug header connections
    
    # Header 0: LED Driver Control Signals
    # debug_headers[0].channels[0].line ~ data_in.line Kinda annoying, all the way across the board.
    debug_headers[0].channels[0].line ~ clusters[0].data_in_micro.line
    debug_headers[0].channels[1].line ~ data_out.line   
    debug_headers[0].channels[2].line ~ data_clock.line
    debug_headers[0].channels[3].line ~ global_clock.line
    debug_headers[0].channels[0].reference.gnd ~ power_3v3.gnd
    
    # Header 1: LED Driver Control + Power
    debug_headers[1].channels[0].line ~ latch.line
    debug_headers[1].channels[1].line ~ power_5v.vcc
    debug_headers[1].channels[2].line ~ power_3v3.vcc
    debug_headers[1].channels[3] ~ switch.reset
    debug_headers[1].channels[0].reference.gnd ~ power_3v3.gnd
    
    # Header 2: Network Communication (MDIO/I2C)
    debug_headers[2].channels[0].line ~ mdio.mdc.line
    debug_headers[2].channels[1].line ~ mdio.mdio.line
    debug_headers[2].channels[2].line ~ clusters[1].data_in_micro.line
    debug_headers[2].channels[3].line ~ clusters[2].data_in_micro.line
    debug_headers[2].channels[0].reference.gnd ~ power_3v3.gnd
    
    # Header 3: RMII Ethernet Signals
    debug_headers[3].channels[0].line ~ micro.rmii.tx_en.line
    debug_headers[3].channels[1].line ~ micro.rmii.txd[0].line
    debug_headers[3].channels[2].line ~ micro.rmii.rxd[0].line
    debug_headers[3].channels[3].line ~ micro.rmii.crs_dv.line
    debug_headers[3].channels[0].reference.gnd ~ power_3v3.gnd
    
    # Header 4: More RMII + Reference Clock
    debug_headers[4].channels[0].line ~ micro.rmii.txd[1].line
    debug_headers[4].channels[1].line ~ micro.rmii.rxd[1].line
    debug_headers[4].channels[2].line ~ micro.rmii.ref_clk.line
    debug_headers[4].channels[3].line ~ micro.rmii.rx_er.line
    debug_headers[4].channels[0].reference.gnd ~ power_3v3.gnd
    
    # Header 5: Spare GPIO + UART for Debug (pins assigned above in pinout section)
    debug_headers[5].channels[0].reference.gnd ~ power_3v3.gnd
    debug_headers[5].channels[1].line ~ clusters[3].data_in_micro.line
        # Serial Debug Interface
    debug_headers[5].channels[2] ~ micro.uart.base_uart.tx  # UART TX for serial debug
    debug_headers[5].channels[3] ~ micro.uart.base_uart.rx  # UART RX for serial debug
    

    # Ground connections
    led_power.gnd ~ power_5v.gnd
    led_power.gnd ~ power_3v3.gnd

    # Net naming
    led_power.vcc.override_net_name = "POWER_LED"
    power_5v.vcc.override_net_name = "POWER_5V"
    power_3v3.vcc.override_net_name = "POWER_3V3"

    data_micro_enable.line.override_net_name = "DATA_MICRO_ENABLE"
    data_snake_enable.line.override_net_name = "DATA_SNAKE_ENABLE_3V3"
    data_snake_enable_5v.line.override_net_name = "DATA_SNAKE_ENABLE_5V"
    data_in.line.override_net_name = "DATA_IN"
    data_out.line.override_net_name = "DATA_OUT"
    data_clock.line.override_net_name = "DATA_CLOCK"
    global_clock.line.override_net_name = "GLOBAL_CLOCK"
    latch.line.override_net_name = "LATCH"
    mdio.mdc.line.override_net_name = "MDIO_MDC"
    mdio.mdio.line.override_net_name = "MDIO_MDIO"
    clusters[0].data_in_micro.line.override_net_name = "DATA_IN_MICRO_0"
    clusters[1].data_in_micro.line.override_net_name = "DATA_IN_MICRO_1"
    clusters[2].data_in_micro.line.override_net_name = "DATA_IN_MICRO_2"
    clusters[3].data_in_micro.line.override_net_name = "DATA_IN_MICRO_3"
    clusters[4].data_in_micro.line.override_net_name = "DATA_IN_MICRO_4"
    clusters[5].data_in_micro.line.override_net_name = "DATA_IN_MICRO_5"
    clusters[6].data_in_micro.line.override_net_name = "DATA_IN_MICRO_6"
    switch.reset.line.override_net_name = "SWITCH_RESET"
    phy._reset.line.override_net_name = "PHY_RESET"
    thermistors[0].output.line.override_net_name = "THERMISTOR_0"
    thermistors[1].output.line.override_net_name = "THERMISTOR_1"
    thermistors[2].output.line.override_net_name = "THERMISTOR_2"
    thermistors[3].output.line.override_net_name = "THERMISTOR_3"
    thermistors[4].output.line.override_net_name = "THERMISTOR_4"
    thermistors[5].output.line.override_net_name = "THERMISTOR_5"
    thermistors[6].output.line.override_net_name = "THERMISTOR_6"
    thermistors[7].output.line.override_net_name = "THERMISTOR_7"
    thermistors[8].output.line.override_net_name = "THERMISTOR_8"


    # Explicit picks
    for header in debug_headers:
        trait header.protection_resistors[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
        trait header.protection_resistors[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
        trait header.protection_resistors[2] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
        trait header.protection_resistors[3] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C11702">
    trait led_3v3.resistor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25744">
    trait led_5v.resistor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25744">
    trait ldo.feedback_divider.r_bottom has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25744">
    trait ldo.feedback_divider.r_top has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C25794">
    trait ldo.input_decoupling_capacitor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C52923">
    trait ldo.output_decoupling_capacitor has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C52923">
    trait micro.decoupling_3v3[0] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[1] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[2] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[3] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[4] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[5] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[6] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
    trait micro.decoupling_3v3[7] has_explicit_part::by_supplier<supplier_id="lcsc", supplier_partno="C1525">
