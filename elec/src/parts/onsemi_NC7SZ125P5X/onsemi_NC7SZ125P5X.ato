module onsemi_NC7SZ125P5X:
    package = new onsemi_NC7SZ125P5X_package
    decoupling_capacitor = new Capacitor

    power = new ElectricPower
    input = new ElectricLogic
    output = new ElectricLogic
    enable = new ElectricLogic

    # power.required = True # Connected by reference
    power.voltage = 1.65V to 5.5V
    input.required = True
    output.required = True
    enable.required = True

    # Connections to package
    power.vcc ~ package.VCC
    power.gnd ~ package.GND
    input.line ~ package.A
    output.line ~ package.Y
    enable.line ~ package.nOE

    for logic in [input, output, enable]:
        logic.reference ~ power
    # decoupling_capacitor.capacitance = 100nF +/- 10%
    decoupling_capacitor.package = "0402"

    power.vcc ~> decoupling_capacitor ~> power.gnd

